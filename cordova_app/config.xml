<?xml version='1.0' encoding='utf-8'?>
<widget id="com.ecopulse.app" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>EcoPulse</name>
    <description>Smart Mobile-Based Environmental Pollution Monitoring System</description>
    <author email="dev@ecopulse.com" href="http://ecopulse.com">EcoPulse Team</author>
    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-navigation href="*" />
    <preference name="KeepRunning" value="true" />
    <preference name="BackgroundColor" value="0xff0b0d19" />
</widget>
